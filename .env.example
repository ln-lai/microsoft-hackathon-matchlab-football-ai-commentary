# Placeholders only. The application reads environment variables, not dotenv files.
# Required for full local inference; the authorized checkpoint is not included.
DEMO_CHECKPOINT=/absolute/path/to/authorized/best.pt

# Optional Microsoft evidence selection. Keep these unset for local fallback.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-EXISTING-INSIGHT-DEPLOYMENT
AZURE_OPENAI_API_KEY=REPLACE-WITH-YOUR-PRIVATE-SERVER-SECRET
AZURE_OPENAI_REASONING_EFFORT=minimal
INSIGHT_MAX_CALLS_PER_MINUTE=6
INSIGHT_MAX_CALLS_TOTAL=100
INSIGHT_TIMEOUT_SECONDS=20
INSIGHT_CACHE_SECONDS=1800

# Optional speech routes. Use only deployments verified in your own account.
# Existing verified GPT clips may be reused; exact-script TTS is preferred for new clips.
AZURE_AUDIO_DEPLOYMENT=YOUR-EXISTING-GPT-AUDIO-DEPLOYMENT
AZURE_TTS_DEPLOYMENT=YOUR-EXISTING-TTS-DEPLOYMENT
COMMENTARY_MAX_CALLS_PER_MINUTE=3
COMMENTARY_MAX_CALLS_TOTAL=60
COMMENTARY_TIMEOUT_SECONDS=25
COMMENTARY_CACHE_DIR=/absolute/path/to/private/commentary-cache
COMMENTARY_SEED_DIR=/absolute/path/to/private/verified-commentary-seed
